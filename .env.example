# --- server ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Log 1-in-N successful requests under load. Non-2xx is always logged.
LOG_SAMPLE_RATE=20
# Swagger UI at /docs. Defaults to on outside production, off in production.
# Set to true on a deployed instance only when you want the explorer public.
SWAGGER_ENABLED=true

# --- database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5433/seats
DATABASE_SSL=false
# Keep the pool well under the server's max_connections. Transactions are ~2ms,
# so a small pool with fast turnover beats a large pool that starves Postgres.
DB_POOL_MAX=15
DB_POOL_MIN=2
DB_CONNECTION_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=3000
DB_IDLE_IN_TX_TIMEOUT_MS=5000

# --- auth ---
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=24h
ADMIN_TOKEN=dev-admin-token

# --- domain ---
DEFAULT_PER_USER_LIMIT=4
DEFAULT_HOLD_SECONDS=120
MAX_HOLD_SECONDS=900
MAX_SEATS_PER_SHOW=20000
MAX_SEATS_PER_RESERVATION=10
IDEMPOTENCY_TTL_HOURS=24
# How long a duplicate request waits for the original to finish before it is
# told to retry. Must comfortably exceed p99 reservation latency, or honest
# retries get a 409 instead of the reservation they already paid for.
IDEMPOTENCY_WAIT_MS=2000

# --- resilience ---
TX_MAX_RETRIES=3
EXPIRY_SWEEP_INTERVAL_MS=5000
EXPIRY_SWEEP_BATCH=500
